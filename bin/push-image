#!/bin/sh
# Builds the image for amd64 and arm64 and pushes it as X.Y.Z, X.Y, X and latest, the version
# taken from install.sh. Needs a buildx builder that does both platforms (BUILDER, default: the
# current one) and a docker login to git.teletypegames.org.
set -eu
cd "$(dirname "$0")/.."
VERSION="$(sed -n 's/^INSTALLER_VERSION="\(.*\)"/\1/p' install.sh)"
REPO="${REPO:-git.teletypegames.org/build/warp-engine-local}"
MINOR="${VERSION%.*}"
MAJOR="${VERSION%%.*}"
set -- --platform linux/amd64,linux/arm64 \
  -t "$REPO:$VERSION" -t "$REPO:$MINOR" -t "$REPO:$MAJOR" -t "$REPO:latest" --push .
if [ -n "${BUILDER:-}" ]; then set -- --builder "$BUILDER" "$@"; fi
echo "pushing $REPO:$VERSION ($MINOR, $MAJOR, latest)"
docker buildx build "$@"
